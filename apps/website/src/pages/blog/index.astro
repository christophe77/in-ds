---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { SITE } from '@/data/site';
import { url } from '@/lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title={`Blog — Industrial UI, HMI & SCADA — ${SITE.name}`}
  description="Articles on industrial interface design: HMI alarm design, framework-agnostic components, design tokens, and why generic UI kits fall short for industrial software."
>
  <PageHeader
    eyebrow="Blog"
    title="Notes on industrial interface design"
    lead="Practical writing on HMI and SCADA UI — alarm design, process semantics, framework-agnostic components and design tokens. Readable whether or not you use ind-ds."
    crumbs={[{ label: 'Home', href: url('/') }, { label: 'Blog' }]}
  >
    <a class="blog__rss" href={url('/rss.xml')}>RSS feed</a>
  </PageHeader>

  <section class="section"><div class="container">
    {posts.length === 0 && <p>No articles yet.</p>}
    <ul class="blog-list">
      {
        posts.map((post) => (
          <li>
            <a href={url(`/blog/${post.id}`)} class="blog-card card card--link">
              <div class="blog-card__meta">
                <time datetime={post.data.publishDate.toISOString()}>{fmt(post.data.publishDate)}</time>
                <span aria-hidden="true">·</span>
                <span>{post.data.author}</span>
              </div>
              <h2 class="blog-card__title">{post.data.title}</h2>
              <p class="blog-card__desc">{post.data.description}</p>
              <ul class="blog-card__tags" aria-label="Tags">
                {post.data.tags.slice(0, 4).map((t) => <li class="tag-chip">{t}</li>)}
              </ul>
            </a>
          </li>
        ))
      }
    </ul>
  </div></section>
</BaseLayout>

<style>
  .blog__rss { margin-top: var(--ind-spacing-4); display: inline-block; font-family: var(--ind-font-family-mono); font-size: var(--ind-font-size-xs); color: var(--ind-surface-text-muted); text-decoration: none; }
  .blog__rss:hover { color: var(--ind-surface-text-primary); }
  .blog-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--ind-spacing-4); }
  .blog-card { display: block; text-decoration: none; }
  .blog-card__meta { display: flex; gap: var(--ind-spacing-2); font-family: var(--ind-font-family-mono); font-size: var(--ind-font-size-xs); color: var(--ind-surface-text-muted); margin-bottom: var(--ind-spacing-2); }
  .blog-card__title { font-size: var(--ind-font-size-xl); margin: 0 0 var(--ind-spacing-2); color: var(--ind-surface-text-primary); }
  .blog-card__desc { margin: 0 0 var(--ind-spacing-3); color: var(--ind-surface-text-secondary); max-width: 68ch; }
  .blog-card__tags { list-style: none; display: flex; flex-wrap: wrap; gap: var(--ind-spacing-2); margin: 0; padding: 0; }
</style>
