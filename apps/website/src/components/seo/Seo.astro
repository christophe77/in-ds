---
import { SITE } from '@/data/site';
import { url } from '@/lib/url';

export interface Props {
  title: string;
  description: string;
  /** Route path (with base), e.g. Astro.url.pathname — used to build the canonical URL. */
  path: string;
  /** Absolute or base-relative OG image URL. Defaults to the site card. */
  ogImage?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    tags?: string[];
  };
  /** Extra JSON-LD objects to embed. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, ogImage, type = 'website', noindex = false, article, jsonLd = [] } =
  Astro.props;

// Astro.site is the configured origin; new URL(path, site) yields the full canonical.
const site = Astro.site ?? new URL('https://christophe77.github.io');
const canonical = new URL(path, site).href.replace(/\/$/, '') || site.href;
const defaultOg = new URL(url('/og/og-default.png'), site).href;
const ogUrl = ogImage ? new URL(ogImage, site).href : defaultOg;
const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;

const baseJsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    description: SITE.description,
    url: site.href,
  },
  ...jsonLd,
];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{article?.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
{article?.author && <meta property="article:author" content={article.author} />}
{article?.tags?.map((t) => <meta property="article:tag" content={t} />)}

{baseJsonLd.map((obj) => (
  <script type="application/ld+json" set:html={JSON.stringify(obj)} />
))}
