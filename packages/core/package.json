{
  "name": "@ind-ds/core",
  "version": "0.0.1",
  "description": "Web components for the industrial HMI/SCADA design system — Stencil-built, framework-agnostic.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "dist/ind-ds/*",
    "dist/esm/loader.js",
    "loader/**"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2017": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "unpkg": "dist/ind-ds/ind-ds.esm.js",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./css/utilities": "./utilities.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "loader",
    "utilities.css"
  ],
  "scripts": {
    "build": "stencil build",
    "dev": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "clean": "rimraf dist loader www src/components.d.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ind-ds/tokens": "workspace:*"
  },
  "devDependencies": {
    "@stencil/core": "^4.22.0",
    "rimraf": "^5.0.5"
  }
}
