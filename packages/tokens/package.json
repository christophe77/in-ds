{
  "name": "@ind-ds/tokens",
  "version": "0.2.1",
  "description": "Industrial HMI/SCADA design tokens — ISA-18.2 alarm priorities, process states, dense spacing. Built with Style Dictionary.",
  "keywords": [
    "design-tokens",
    "design-system",
    "style-dictionary",
    "hmi",
    "scada",
    "industrial",
    "isa-18.2",
    "css-variables",
    "tokens"
  ],
  "license": "MIT",
  "author": "ind-ds contributors",
  "homepage": "https://github.com/christophe77/ind-ds#readme",
  "bugs": {
    "url": "https://github.com/christophe77/ind-ds/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/ind-ds.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/js/tokens.js",
  "module": "./dist/js/tokens.js",
  "types": "./dist/js/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/js/tokens.d.ts",
      "import": "./dist/js/tokens.js"
    },
    "./css": "./dist/css/tokens.css",
    "./css/light": "./dist/css/themes/light.css",
    "./css/high-contrast": "./dist/css/themes/high-contrast.css",
    "./json": "./dist/json/tokens.json",
    "./dart": "./dist/dart/tokens.dart"
  },
  "files": [
    "dist",
    "tokens",
    "style-dictionary.config.js",
    "README.md"
  ],
  "scripts": {
    "build": "node style-dictionary.config.js",
    "prepack": "pnpm run build",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "style-dictionary": "^4.1.3"
  }
}
