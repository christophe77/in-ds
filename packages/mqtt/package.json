{
  "name": "@ind-ds/mqtt",
  "version": "0.2.1",
  "description": "MQTT adapter for ind-ds — binds broker topics to web component attributes for live HMI updates.",
  "keywords": [
    "mqtt",
    "realtime",
    "hmi",
    "scada",
    "industrial",
    "web-components",
    "telemetry",
    "iiot"
  ],
  "license": "MIT",
  "author": "ind-ds contributors",
  "homepage": "https://github.com/christophe77/ind-ds#readme",
  "bugs": {
    "url": "https://github.com/christophe77/ind-ds/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/ind-ds.git",
    "directory": "packages/mqtt"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "pnpm run build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "mqtt": "^5.10.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
}
