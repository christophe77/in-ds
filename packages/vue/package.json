{
  "name": "@ind-ds/vue",
  "version": "0.1.0",
  "description": "Vue 3 wrappers for @ind-ds/core web components — typed components with v-model support for an industrial HMI/SCADA design system.",
  "keywords": [
    "vue",
    "vue3",
    "vue-components",
    "design-system",
    "hmi",
    "scada",
    "industrial",
    "isa-18.2",
    "web-components",
    "ui-kit"
  ],
  "license": "MIT",
  "author": "ind-ds contributors",
  "homepage": "https://github.com/christophe77/in-ds#readme",
  "bugs": {
    "url": "https://github.com/christophe77/in-ds/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/in-ds.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "dependencies": {
    "@ind-ds/core": "workspace:*"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "typescript": "^5.5.4",
    "vue": "^3.4.0"
  }
}
