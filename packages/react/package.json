{
  "name": "@ind-ds/react",
  "version": "0.1.1",
  "description": "React 18+ wrappers for @ind-ds/core web components — typed forwardRef components for an industrial HMI/SCADA design system.",
  "keywords": [
    "react",
    "react-components",
    "design-system",
    "hmi",
    "scada",
    "industrial",
    "isa-18.2",
    "web-components",
    "ui-kit"
  ],
  "license": "MIT",
  "author": "ind-ds contributors",
  "homepage": "https://github.com/christophe77/ind-ds#readme",
  "bugs": {
    "url": "https://github.com/christophe77/ind-ds/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/christophe77/ind-ds.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter @ind-ds/core build && tsc",
    "prepack": "pnpm run build",
    "dev": "tsc --watch",
    "clean": "rimraf dist"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@ind-ds/core": "workspace:*",
    "@stencil/react-output-target": "^1.5.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^5.0.5",
    "typescript": "^5.5.4"
  }
}
